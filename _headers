# Cloudflare Pages headers.
# The app is a single self-contained page; everything heavy (model weights,
# transformers.js) comes from third-party CDNs, so caching here is cheap.
#
# Never add Cross-Origin-Embedder-Policy: the CDN module and the model
# download carry no CORP header, so COEP would block both.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# The page is the unversioned entry point and carries the whole app, so it must
# always be revalidated: a stale copy is a stale application.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Brand assets are content-stable and regenerated by build_icons.py, not edited,
# so a week of caching never serves a wrong version for long.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-96x96.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-512-maskable.png
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
